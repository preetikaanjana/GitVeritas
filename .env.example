# Server Configuration
PORT=8000

# Google Gemini API Key (Required for Generative AI Recruiter Dossier & Code Copilot)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (Optional, boosts API rate limits to 5,000 req/hr)
GITHUB_TOKEN=your_github_token_here
# GITHUB_PAT=your_github_pat_here

# Transformers & Embeddings Settings (Optional)
# Set to 1 to bypass local SBERT transformer loading in constrained CI/CD environments
# DISABLE_TRANSFORMERS=0
